# PostgreSQL 16 with the pgvector extension
DATABASE_URL=postgresql://legal:legal@localhost:5432/legal_integrity
# Where downloaded archives are cached (default: backend/data)
DATA_DIR=
# Hugging Face token: required for IL-PCSR (gated); optional for open-india-law (public mirror used otherwise)
HF_TOKEN=
# Embedding model (fastembed, 384 dimensions)
EMBED_MODEL=BAAI/bge-small-en-v1.5
# Frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
